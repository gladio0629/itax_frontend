# Backend base URL, e.g. https://api.example.com. Empty: dev goes through the Vite proxy, a production build shows "no server".
VITE_API_URL=
# true = built-in sample data (mock adapter, no network); false = the real backend (http adapter).
VITE_DEMO_MODE=false
# Mapbox public token (pk.…) for the interactive map. Empty: the drawn map is used and the build has no Mapbox code.
# Put the real value in .env.local (gitignored) or in the host's build settings — never in a tracked file.
VITE_MAPBOX_TOKEN=
# Public website with /terms, /privacy, /delete-account (opened in the system browser). Unset: https://xasanow.uz (src/config.ts). Empty: the names show without links.
# VITE_SITE_URL=
