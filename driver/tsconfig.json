{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      "@active-adapter": [
        "src/api/adapters/http.ts"
      ],
      "@map-provider": [
        "../shared/map/provider.mapbox.ts"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "node_modules/@types/react/jsx-runtime"
      ],
      "react-dom": [
        "node_modules/@types/react-dom"
      ],
      "mapbox-gl": [
        "node_modules/mapbox-gl"
      ]
    }
  },
  "include": [
    "src",
    "../shared/http",
    "../shared/api",
    "../shared/map"
  ],
  "exclude": [
    "../shared/**/*.test.ts"
  ]
}
